# Swep Environment Configuration

# Swep Gate URL (mặc định dùng server local hoặc deploy trên Vercel)
SWEP_GATE_URL=http://localhost:3000

# GitHub OAuth App Client ID (dùng cho Device Flow)
GITHUB_CLIENT_ID=your_github_oauth_client_id

# Server Secrets (Chỉ cần thiết lập trên Swep Gate, KHÔNG đặt trên client máy mượn)
PEPPER=swep_super_secret_pepper_string_do_not_leak
SERVER_KEY=01234567890123456789012345678901
PORT=3000
